<!--
  Windows application manifest embedded into maekon-app TEST binaries only
  (see build.rs). Test harnesses that link tauri need the
  Microsoft.Windows.Common-Controls v6 side-by-side dependency declared, or
  the loader binds comctl32 v5 (missing TaskDialogIndirect) and the test exe
  dies at startup with STATUS_ENTRYPOINT_NOT_FOUND (0xc0000139) before any
  test runs. Content mirrors tauri-build's windows-app-manifest.xml; the real
  app binary keeps getting its manifest from tauri_build instead.
  Upstream: https://github.com/tauri-apps/tauri/pull/4383#issuecomment-1212221864
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <dependency>
    <dependentAssembly>
      <assemblyIdentity
        type="win32"
        name="Microsoft.Windows.Common-Controls"
        version="6.0.0.0"
        processorArchitecture="*"
        publicKeyToken="6595b64144ccf1df"
        language="*"
      />
    </dependentAssembly>
  </dependency>
</assembly>
