<!--
  Windows application manifest embedded by build.rs (linker /MANIFEST:EMBED)
  into EVERY linked binary of the maekon-app package — the real app AND its
  test harnesses. Binaries linking tauri need the
  Microsoft.Windows.Common-Controls v6 side-by-side dependency declared, or
  the loader binds comctl32 v5 (missing TaskDialogIndirect) and the exe dies
  at startup with STATUS_ENTRYPOINT_NOT_FOUND (0xc0000139). tauri_build's own
  winres manifest is disabled in build.rs (new_without_app_manifest) so the
  bin does not carry a duplicate RT_MANIFEST; this file mirrors tauri-build's
  default windows-app-manifest.xml content.
  Upstream: https://github.com/tauri-apps/tauri/pull/4383#issuecomment-1212221864
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <dependency>
    <dependentAssembly>
      <assemblyIdentity
        type="win32"
        name="Microsoft.Windows.Common-Controls"
        version="6.0.0.0"
        processorArchitecture="*"
        publicKeyToken="6595b64144ccf1df"
        language="*"
      />
    </dependentAssembly>
  </dependency>
</assembly>
