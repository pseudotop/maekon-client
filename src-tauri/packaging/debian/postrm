#!/bin/sh
# Unload the AppArmor profile when the package goes away (#11023). Leaving a
# loaded profile behind for a binary that no longer exists is harmless but
# untidy, and it confuses `aa-status` output.
set -e

PROFILE=/etc/apparmor.d/maekon

case "$1" in
  remove|purge)
    if [ -e "$PROFILE" ] \
      && command -v apparmor_parser >/dev/null 2>&1 \
      && [ -d /sys/kernel/security/apparmor ]; then
      apparmor_parser -R "$PROFILE" >/dev/null 2>&1 || true
    fi
    ;;
esac

# #11065 choice 3: preserve user profiles and keys, and explain the boundary.
# Runtime files belong to each user, not dpkg. Scanning homes or accessing a
# user's credential store from root would risk other profiles and LDAP/NFS homes.
# #12534: Linux keeps the durable DB key in data_dir/.db_key; kernel keyutils is
# a cache. Secret Service tools do not address this build's kernel-keyring backend.
# MAEKON_PROFILE_POLICY=preserve-v1
#
# `purge` only: leaving user data across `remove` is the Debian convention and
# needs no notice. `purge` is where "everything is gone" is the natural reading,
# so that is where the gap has to be stated.
if [ "$1" = "purge" ]; then
  cat <<'EOF'

Maekon: profile data was NOT removed by this purge.

  ~/.config/maekon        settings
  ~/.local/share/maekon   local database and logs

These runtime files belong to each user, so package remove and purge preserve
them. The durable database key is ~/.local/share/maekon/.db_key (owner-only).
The Linux kernel keyring caches that key; package removal leaves the cache alone.

To remove these profile files yourself, first stop Maekon and decide which
backups to keep. As the user who ran Maekon:

  rm -rf ~/.config/maekon ~/.local/share/maekon

This also removes the durable .db_key and can make retained encrypted database
copies unreadable. It does not erase backups, separately configured credential
files, or kernel-keyring entries. Cached keys may remain until expiry or reboot;
removing profile files is not proof of complete secret erasure.

These are the unflavored package paths. A flavored build uses its own
maekon-<flavor> profile and credential namespace.

EOF
fi

exit 0
