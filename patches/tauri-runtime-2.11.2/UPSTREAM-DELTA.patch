# UPSTREAM-DELTA.patch -- tauri-runtime 2.11.2
#
# Unified diff: pristine crates.io source (static.crates.io tarball,
# tauri-runtime-2.11.2.crate) -> vendored source at patches/tauri-runtime-2.11.2/.
# This is the ground-truth record of what Maekon changed relative to
# upstream. See ../README.md for the refresh procedure and the why/what
# summary per crate.
#
# Regenerate with:
#   curl -L https://static.crates.io/crates/tauri-runtime/tauri-runtime-2.11.2.crate -o /tmp/tauri-runtime-2.11.2.crate
#   mkdir -p /tmp/pristine && tar xzf /tmp/tauri-runtime-2.11.2.crate -C /tmp/pristine
#   diff -ruN --exclude=target --exclude=.cargo_vcs_info.json \
#     --exclude=.cargo-ok --exclude=Cargo.toml.orig --exclude=Cargo.lock \
#     /tmp/pristine/tauri-runtime-2.11.2 patches/tauri-runtime-2.11.2 > patches/tauri-runtime-2.11.2/UPSTREAM-DELTA.patch
#
# Excluded as crates.io tarball / repo-local packaging noise (see README
# 'Exclusions' section): .cargo_vcs_info.json, .cargo-ok, Cargo.toml.orig,
# Cargo.lock (per-patch-crate lockfiles were removed as non-shipping
# Dependabot noise, PR #5862 / commit 1a4a0a85f0), target/.
#
diff -ruN --exclude=target --exclude=.cargo_vcs_info.json --exclude=.cargo-ok --exclude=Cargo.toml.orig --exclude=Cargo.lock upstream/Cargo.toml vendored/Cargo.toml
--- upstream/Cargo.toml
+++ vendored/Cargo.toml
@@ -97,12 +97,14 @@
 default-features = false
 
 [target.'cfg(any(target_os = "linux", target_os = "dragonfly", target_os = "freebsd", target_os = "openbsd", target_os = "netbsd"))'.dependencies.gtk]
-version = "0.18"
-features = ["v3_24"]
+version = "0.11"
+features = ["v4_6"]
+package = "gtk4"
 
-[target.'cfg(any(target_os = "linux", target_os = "dragonfly", target_os = "freebsd", target_os = "openbsd", target_os = "netbsd"))'.dependencies.webkit2gtk]
-version = "=2.0"
-features = ["v2_40"]
+[target.'cfg(any(target_os = "linux", target_os = "dragonfly", target_os = "freebsd", target_os = "openbsd", target_os = "netbsd"))'.dependencies.webkit6]
+version = "0.6"
+features = ["v2_50"]
+package = "webkit6"
 
 [target.'cfg(target_os = "android")'.dependencies.jni]
 version = "0.21"
diff -ruN --exclude=target --exclude=.cargo_vcs_info.json --exclude=.cargo-ok --exclude=Cargo.toml.orig --exclude=Cargo.lock upstream/src/webview.rs vendored/src/webview.rs
