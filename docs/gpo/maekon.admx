<?xml version="1.0" encoding="utf-8"?>
<!--
  Maekon managed-policy ADMX template (E20-45 #4837) — REFERENCE.

  Maps the Maekon managed.json lockable allowlist (E20-40 #4832; see
  docs/contracts/managed.schema.json and crates/maekon-core/src/config/managed.rs)
  to Windows Group Policy. Importing this into the Central Store
  (%SystemRoot%\PolicyDefinitions or the domain SYSVOL Central Store) surfaces the
  six lockable Maekon policies under Computer Configuration > Administrative Templates.

  STATUS: reference template. (1) Validate with `admchk.exe` (or load in gpedit.msc)
  on a Windows host before deployment — it was authored on a non-Windows host and is
  NOT machine-validated. (2) Today the enforcement path is the managed.json file
  distributed via MDM/file (see enterprise-deployment.md). The registry values these
  policies write under HKLM\Software\Policies\Maekon are NOT yet auto-translated into
  managed.json; a registry->managed.json bridge is future work. Until then, treat this
  as the canonical documentation of the policy surface and author managed.json directly.
-->
<policyDefinitions xmlns:xsd="http://www.w3.org/2001/XMLSchema"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   revision="1.0" schemaVersion="1.0"
                   xmlns="http://schemas.microsoft.com/GroupPolicy/2006/07/PolicyDefinitions">
  <policyNamespaces>
    <target prefix="maekon" namespace="Maekon.Policies.Managed" />
    <using prefix="windows" namespace="Microsoft.Policies.Windows" />
  </policyNamespaces>
  <resources minRequiredRevision="1.0" />
  <categories>
    <category name="Maekon" displayName="$(string.Cat_Maekon)" />
  </categories>
  <policies>
    <policy name="Telemetry_Enabled" class="Machine"
            displayName="$(string.Telemetry_Enabled)"
            explainText="$(string.Telemetry_Enabled_Help)"
            key="Software\Policies\Maekon" valueName="telemetry.enabled">
      <parentCategory ref="Maekon" />
      <supportedOn ref="windows:SUPPORTED_Windows7" />
      <enabledValue><decimal value="1" /></enabledValue>
      <disabledValue><decimal value="0" /></disabledValue>
    </policy>
    <policy name="Telemetry_CrashReports" class="Machine"
            displayName="$(string.Telemetry_CrashReports)"
            explainText="$(string.Telemetry_CrashReports_Help)"
            key="Software\Policies\Maekon" valueName="telemetry.crash_reports">
      <parentCategory ref="Maekon" />
      <supportedOn ref="windows:SUPPORTED_Windows7" />
      <enabledValue><decimal value="1" /></enabledValue>
      <disabledValue><decimal value="0" /></disabledValue>
    </policy>
    <policy name="Vision_CaptureEnabled" class="Machine"
            displayName="$(string.Vision_CaptureEnabled)"
            explainText="$(string.Vision_CaptureEnabled_Help)"
            key="Software\Policies\Maekon" valueName="vision.capture_enabled">
      <parentCategory ref="Maekon" />
      <supportedOn ref="windows:SUPPORTED_Windows7" />
      <enabledValue><decimal value="1" /></enabledValue>
      <disabledValue><decimal value="0" /></disabledValue>
    </policy>
    <policy name="Update_Enabled" class="Machine"
            displayName="$(string.Update_Enabled)"
            explainText="$(string.Update_Enabled_Help)"
            key="Software\Policies\Maekon" valueName="update.enabled">
      <parentCategory ref="Maekon" />
      <supportedOn ref="windows:SUPPORTED_Windows7" />
      <enabledValue><decimal value="1" /></enabledValue>
      <disabledValue><decimal value="0" /></disabledValue>
    </policy>
    <policy name="Privacy_PiiFilterLevel" class="Machine"
            displayName="$(string.Privacy_PiiFilterLevel)"
            explainText="$(string.Privacy_PiiFilterLevel_Help)"
            key="Software\Policies\Maekon" presentation="$(presentation.Privacy_PiiFilterLevel)">
      <parentCategory ref="Maekon" />
      <supportedOn ref="windows:SUPPORTED_Windows7" />
      <elements>
        <enum id="Privacy_PiiFilterLevel_Enum" valueName="privacy.pii_filter_level">
          <item displayName="$(string.Pii_Off)"><value><string>Off</string></value></item>
          <item displayName="$(string.Pii_Basic)"><value><string>Basic</string></value></item>
          <item displayName="$(string.Pii_Standard)"><value><string>Standard</string></value></item>
          <item displayName="$(string.Pii_Strict)"><value><string>Strict</string></value></item>
        </enum>
      </elements>
    </policy>
    <policy name="Audio_CloudSttPolicy" class="Machine"
            displayName="$(string.Audio_CloudSttPolicy)"
            explainText="$(string.Audio_CloudSttPolicy_Help)"
            key="Software\Policies\Maekon" presentation="$(presentation.Audio_CloudSttPolicy)">
      <parentCategory ref="Maekon" />
      <supportedOn ref="windows:SUPPORTED_Windows7" />
      <elements>
        <enum id="Audio_CloudSttPolicy_Enum" valueName="audio.cloud_stt_policy">
          <item displayName="$(string.Stt_Allow)"><value><string>allow</string></value></item>
          <item displayName="$(string.Stt_RequireAdminApproval)"><value><string>require_admin_approval</string></value></item>
          <item displayName="$(string.Stt_Disabled)"><value><string>disabled</string></value></item>
        </enum>
      </elements>
    </policy>
  </policies>
</policyDefinitions>
