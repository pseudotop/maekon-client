{
  "name": "maekon-dashboard",
  "version": "0.0.1-rc.6",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5273 --strictPort",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "biome check src/ && bash scripts/lint-design-tokens.sh",
    "lint:tokens": "bash scripts/lint-design-tokens.sh",
    "lint:fix": "biome check --write src/",
    "format": "biome format --write src/",
    "test": "vitest run",
    "test:pnpm-config": "node scripts/test-pnpm-config.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "qa:pwcli:help": "pnpm exec playwright-cli --help",
    "qa:pwcli:open": "pnpm exec playwright-cli -s=maekon-qa open http://localhost:10090 --headed --persistent",
    "qa:pwcli:open:preview": "pnpm exec playwright-cli -s=maekon-qa open http://localhost:10091 --headed --persistent",
    "qa:pwcli:snapshot": "pnpm exec playwright-cli -s=maekon-qa snapshot",
    "qa:pwcli:show": "pnpm exec playwright-cli show",
    "qa:pwcli:close": "pnpm exec playwright-cli -s=maekon-qa close",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "verify:web-e2e": "pnpm build && playwright test --reporter=line",
    "test:e2e:live": "playwright test --config playwright-live.config.ts",
    "test:e2e:live:headed": "playwright test --config playwright-live.config.ts --headed",
    "test:e2e:live:report": "playwright show-report playwright-live-report",
    "test:e2e:tauri": "wdio run e2e-tauri/wdio.conf.ts",
    "test:e2e:tauri:watch": "wdio run e2e-tauri/wdio.conf.ts --watch",
    "storybook": "storybook dev -p 6006",
    "storybook:review": "storybook dev -p 6007 -c .storybook-review",
    "build-storybook": "storybook build",
    "build-storybook:review": "storybook build -c .storybook-review -o storybook-review-static"
  },
  "dependencies": {
    "@lobehub/icons-static-svg": "^1.88.0",
    "@tanstack/react-query": "^5.100.6",
    "@tauri-apps/api": "^2",
    "clsx": "^2.1.1",
    "i18next": "^23.16.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.1.0",
    "react-markdown": "^9.0.0",
    "react-router-dom": "^6.30.4",
    "react-syntax-highlighter": "^16.1.1",
    "recharts": "^2.14.1",
    "remark-gfm": "^4.0.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@playwright/cli": "^0.1.9",
    "@playwright/test": "^1.59.1",
    "@storybook/addon-a11y": "^10.3.5",
    "@storybook/addon-docs": "^10.3.5",
    "@storybook/addon-themes": "^10.3.5",
    "@storybook/react-vite": "^10.3.5",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.6.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^4.3.3",
    "@wdio/cli": "^9.27.0",
    "@wdio/globals": "^9.27.0",
    "@wdio/json-reporter": "^9.20.0",
    "@wdio/local-runner": "^9.27.0",
    "@wdio/mocha-framework": "^9.27.0",
    "@wdio/spec-reporter": "^9.27.0",
    "@wdio/types": "^9.27.0",
    "autoprefixer": "^10.5.0",
    "jsdom": "^25.0.0",
    "postcss": "^8.5.12",
    "storybook": "^10.3.5",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.5",
    "webdriverio": "^9.27.0"
  }
}
